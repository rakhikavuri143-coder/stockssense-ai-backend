# Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database (Optional - fallback to SQLite if not provided)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=stock_agent

# Paper Trading Capital (in INR ₹)
PAPER_CAPITAL=10000

# AI Confidence Threshold (default 90%)
AI_CONFIDENCE_THRESHOLD=90

# Server settings
HOST=0.0.0.0
PORT=8000

# Telegram Bot Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
